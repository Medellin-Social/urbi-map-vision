Ref: afiliados."ciudad_id" > ciudades."id"
Ref: afiliados."usuario_id" > usuarios."id"
Ref: agency_invite."agency_id" > agency."id"
Ref: agency_invite."agent_id" > agent."id"
Ref: agency_member."agency_id" > agency."id"
Ref: agency_member."agent_id" > agent."id"
Ref: agent."usuario_id" > usuarios."id"
