Ref: agente_reviews."agente_id" > agentes."id"
Ref: agente_reviews."usuario_id" > usuarios."id"
Ref: agente_solicitudes."agente_id" > agentes."id"
Ref: agente_solicitudes."listing_id" > listings_propios."id"
Ref: agente_solicitudes."user_id" > usuarios."id"
Ref: agentes."ciudad_id" > ciudades."id"
Ref: agentes."usuario_id" > usuarios."id"
Ref: aplicaciones_afiliado."ciudad_id" > ciudades."id"
Ref: aplicaciones_embajador."barrio_id" > "raw.barrios"."id"
