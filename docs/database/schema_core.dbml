Enum agency_member_rol {
  "owner"
  "agente"
}

Enum agency_tipo {
  "independiente"
  "agencia"
}

Enum agent_estado {
  "pendiente"
  "activo"
  "rechazado"
  "inactivo"
}

Enum due_diligence_estado {
