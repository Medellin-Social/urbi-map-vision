# ══════════════════════════════════════════════════════════════
# Railway environment variables — Medellin Social
# Pega estas variables en Railway → Service → Variables
# ══════════════════════════════════════════════════════════════

# ── Servicio Frontend ─────────────────────────────────────────
# URL del backend FastAPI en Railway (sin trailing slash)
VITE_API_URL=https://YOUR-API-SERVICE.up.railway.app

# Mapbox public token (safe to expose — pk.* prefix)
VITE_MAPBOX_TOKEN=pk.REPLACE_WITH_YOUR_PUBLIC_MAPBOX_TOKEN

# Google Sign-In button — same value as GOOGLE_CLIENT_ID below, public (Vite-exposed)
VITE_GOOGLE_CLIENT_ID=

# Frontend error reporting (optional; Sentry stays off when empty). Must be set as a Railway
# variable AND is passed to the Docker build as an ARG (see Dockerfile).
VITE_SENTRY_DSN=

# ── Servicio Backend (Dockerfile.api) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/urbidata
SECRET_KEY=genera_un_secret_key_largo_aqui
# REQUERIDA — la API crashea al arrancar sin esto (mín 32 chars).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Setear en servicios API y cron. Rotarla desloguea a todos los usuarios.
JWT_SECRET=genera_un_jwt_secret_de_minimo_32_caracteres
CORS_ORIGINS=https://YOUR-FRONTEND.up.railway.app
USD_TO_COP=4100
EUR_TO_COP=4500
AIRROI_API_KEY=pon_tu_api_key_aqui

# ── Google Sign-In + Gmail API ──────────────────────────────────────────
# Ver docs/GOOGLE_AUTH_SETUP.md — un solo OAuth Client (Web application) para
# ambos usos. Sin GOOGLE_REFRESH_TOKEN, el envío de correos cae a SMTP_* si
# están seteadas, o a un stub que solo imprime en logs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=

# ── Listing link health (scraping/link_checker + /api/v1/link-review) ──
# Broken-link candidates are e-mailed for human review; nothing is retired without a click.
LINK_REVIEW_EMAILS=team@easeassociation.com
LINK_REVIEW_SECRET=            # >=16 random chars (HMAC key for Retire/Keep links); generate: openssl rand -hex 32
LINK_REVIEW_BASE_URL=          # public API base used in e-mailed links, e.g. https://<api-host>
LINK_CHECK_CONTACT=            # contact (email/url) shown in the checker's User-Agent
# LINK_CHECK_BOT_URL=  LINK_CHECK_DOMAIN_DELAY=1.0  LINK_CHECK_MAX_GONE_PCT=30  LINK_CHECK_ALERT_WEBHOOK=
# LINK_AUTO_RETIRE_AFTER_DAYS=   # optional, default OFF (unreviewed candidates only ever re-mail after 7 days)

# ── Security hardening (2026-10) ──
# ADMIN_EMAIL account must already exist and be email-verified (sign in once via Google/magic link).
RESERVED_EMAILS=
JWT_EXPIRY_HOURS=168
# Leave ENV unset in production (fail-closed: no /docs, no localhost CORS).
TRUSTED_PROXY_COUNT=
# Optional extra layers (all off when empty):
# SITE_URL / VITE_SITE_URL=https://medellinsocial.com   # canonical origin: sitemap, robots, og:url
# HttpOnly cookie sessions (JWT unreadable by page scripts). Turn on ONLY once the API is
# served from the same site as the web app (e.g. api.medellinsocial.com): browsers block
# third-party cookies, so with the API on *.up.railway.app logins would silently fail.
#   API:  AUTH_COOKIE_MODE=1  [AUTH_COOKIE_DOMAIN=.medellinsocial.com]  CORS_ORIGINS=<exact web origins>
#   Web build: VITE_AUTH_COOKIE_MODE=1
# CORS_ORIGIN_REGEX=             # wildcard preview origins; prod default allows none (list exact ones in CORS_ORIGINS)
# ADMIN_ALLOWED_IPS=             # comma list: admin API only from these client IPs
# ADMIN_REQUIRE_DB_ROLE=1        # also require usuarios.rol='admin' (0111 seeds it for ADMIN_EMAIL)
# GHL_LEADS_ALLOWED_IPS=         # comma list for /api/v1/ghl/leads; GHL_LEADS_TOKEN accepts "old,new" while rotating
# GHL (LeadConnector) outbound: Contacts/visitas/listings. Sin token el push es no-op.
# GHL_PRIVATE_TOKEN=            # Private Integration token (Bearer)
# GHL_LOCATION_ID=              # sub-account locationId
# GHL_WEBHOOK_SECRET=           # X-Webhook-Secret para POST /api/v1/webhook/ghl (inbound)
# Scraper services (urbi-cron) only: portal web-client keys, no defaults in code.
HABI_API_KEY=
METROCUADRADO_API_KEY=
# Scraper hygiene / data quality (urbi-cron). All optional, defaults shown.
# SCRAPER_CONTACT_URL=https://medellinsocial.com   # shown in the bot User-Agent
# SCRAPER_RESPECT_ROBOTS=1  SCRAPER_MAX_PAGE_FAIL_PCT=10  SCRAPER_MAX_PARSE_FAIL_PCT=20
# FINCARAIZ_MAX_PAGES=600   BARRIO_MAX_DISTANCE_M=300
# STALE_DAYS=10  STALE_MAX_PCT=30                     # scripts/deactivate_stale_listings.py
# DATA_QUALITY_ALERT_WEBHOOK=                         # Slack-compatible; also uses SENTRY_DSN
# FRESHNESS_HOURS=48  VOLUME_DROP_PCT=30  NO_PHOTO_MAX_PCT=40
# AIRROI_MONTHLY_CALL_CAP=1000  GOOGLE_PLACES_MONTHLY_CALL_CAP=5000


# ══════════════════════════════════════════════════════════════
# Resto de variables que lee el código (api/ + cron). Sin valores reales.
# ══════════════════════════════════════════════════════════════

# ── Entorno / URLs públicas ──
# ENV=dev                        # SOLO en local/DEV: activa stubs de email/S3, /docs y CORS localhost. En prod dejar vacía.
# EXPOSE_DOCS=1                  # mostrar /docs en prod (default off)
APP_URL=https://medellinsocial.com        # links en correos (magic link, avisos, reportes)
FRONTEND_URL=https://medellinsocial.com   # success/cancel URL de Stripe Checkout
SENTRY_DSN=                      # errores del API/cron; en prod los fallos de config (email/S3) se reportan aquí

# ── Email: Gmail API (arriba) o SMTP ──
# En prod sin ninguno de los dos, send_email falla y reporta a Sentry (ya no hay stub silencioso).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                       # app password de Gmail
SMTP_FROM=                       # remitente de correos de visitas (default SMTP_USER)
EMAIL_FROM=                      # remitente de send_email (default SMTP_USER)
ADMIN_EMAIL=                     # destino de avisos al admin (leads, fallos GHL agotados)
RENTAL_INQUIRIES_TO=             # destino de visitas sin agente / escaladas
ADMIN_WHATSAPP=                  # número que se muestra en el flujo de suscripción

# ── Fotos: S3 / Cloudflare R2 ──
# En prod sin S3_BUCKET la subida de fotos responde 503 (ya no guarda URL placeholder).
S3_BUCKET=                       # alias: AWS_BUCKET
S3_ENDPOINT_URL=                 # R2: https://<account_id>.r2.cloudflarestorage.com (alias AWS_ENDPOINT)
S3_PUBLIC_URL=                   # base pública/CDN (alias AWS_URL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto                  # alias AWS_DEFAULT_REGION

# ── Pagos ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_AGENTE_USD=
STRIPE_PRICE_ID_PRO_USD=         # plan Pro retirado para nuevas compras; se mantiene para suscriptores existentes
ENABLE_SIMULATED_PAYMENTS=       # 1 = pagos simulados (SOLO DEV)

# ── GHL links de pago / programa de agentes ──
GHL_LINK_REGISTRO=
GHL_LINK_CERT_CUOTA=
GHL_LINK_CERT_MENSUAL=
GHL_LINK_CERT_ILIMITADO=
GHL_LINK_ANUNCIO=
GHL_SLOT_CHECKOUT_URL=           # checkout de slots de realtor (cron run_realtor_slots)
EASE_EXAM_URL=                   # link al examen EASE en el programa de agentes
# GHL_LEADS_TOKEN=               # Bearer de /api/v1/ghl/leads (ver arriba GHL_LEADS_ALLOWED_IPS)

# ── Auth / sesiones ──
REQUIRE_EMAIL_VERIFICATION=false # true = exigir email verificado para acciones protegidas
# SESSION_MAX_DAYS=30
# AUTH_COOKIE_SAMESITE=lax  AUTH_COOKIE_INSECURE=   # INSECURE solo en local sin https
# MAX_BODY_BYTES=1048576  MAX_UPLOAD_BODY_BYTES=12582912
# ANTI_SCRAPE_DISABLED=  ANTI_SCRAPE_EXTRA_UAS=

# ── Tiempos de asignación / visitas (cron) ──
# ASIGNADO_TIMEOUT_HORAS=24  VISITA_RECORDATORIO_HORAS=12  VISITA_REASIGNAR_HORAS=24

# ── Datos / scrapers (urbi-cron) ──
GOOGLE_PLACES_API_KEY=
HERE_API_KEY=
MEETUP_TOKEN=
# AIRROI_DELAY_SECONDS=  VRBO_PROXY=  SCRAPER_USER_AGENT=
# NOTICIAS_CLF_MODEL=  NOTICIAS_CLF_UMBRAL=
# TRANSLATE_MODEL_ES_EN=  TRANSLATE_MODEL_EN_ES=  TRANSLATE_TOK_ES_EN=  TRANSLATE_TOK_EN_ES=
# LINK_AUTO_RETIRE_EVIDENCE_HOURS=  LINK_REVIEW_FALLBACK_DIR=  LINK_REVIEW_KEEP_DAYS=
# LINK_REVIEW_REMINDER_DAYS=  LINK_REVIEW_TOKEN_TTL_DAYS=
# Scripts que aceptan POSTGRES_* en vez de DATABASE_URL:
# POSTGRES_HOST=  POSTGRES_PORT=  POSTGRES_DB=  POSTGRES_USER=  POSTGRES_PASSWORD=
# RAILWAY_ENVIRONMENT / RAILWAY_ENVIRONMENT_NAME las pone Railway solo.
# REALTOR_DEMO_PASSWORD=         # solo scripts/seed_realtor_demo.py (DEV)
