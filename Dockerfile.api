FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY alembic/ ./alembic/
COPY alembic.ini .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

EXPOSE 8000

# Run unprivileged. The API only reads /app (no volumes, uploads go to R2) and
# binds $PORT (> 1024); alembic needs network + DATABASE_URL only. If a Railway
# volume is ever mounted, make it writable for uid 10001 (RAILWAY_RUN_UID=10001).
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

# --proxy-headers + --forwarded-allow-ips='*': detrás del proxy TLS de Railway, sin
# esto uvicorn no confía en X-Forwarded-Proto y arma los redirects (ej. trailing-slash
# de /listings-propios) con scheme http:// → el browser los bloquea por mixed-content
# (publicar se rompía). El contenedor solo es alcanzable vía el proxy → '*' es seguro.
CMD sh -c "alembic upgrade head && uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"
