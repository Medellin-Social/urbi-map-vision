FROM python:3.12-slim

WORKDIR /app

# Install cron and pipeline deps
RUN apt-get update && apt-get install -y --no-install-recommends cron && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY scripts/ ./scripts/
COPY api/ ./api/

# Crontab: run refresh daily at 03:00 UTC
RUN echo "0 3 * * * root cd /app && python scripts/refresh_data.py >> /var/log/refresh.log 2>&1" \
    > /etc/cron.d/urbidata-refresh \
    && chmod 0644 /etc/cron.d/urbidata-refresh \
    && crontab /etc/cron.d/urbidata-refresh

CMD ["cron", "-f"]
